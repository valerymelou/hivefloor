{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "vitest.config.mts",
    "tsdown.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.d.ts",
    "src/test/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
