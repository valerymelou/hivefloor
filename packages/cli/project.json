{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cli/src",
  "projectType": "library",
  "tags": ["scope:cli"],
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/tsdown.config.ts",
        "{workspaceRoot}/LICENSE"
      ],
      "outputs": ["{workspaceRoot}/dist/packages/cli"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsdown"
      }
    },
    "typecheck": {},
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "dependsOn": ["build"]
    },
    "bench": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/bench-hook.mjs",
        "env": {
          "HIVEFLOOR_BENCH_BUDGET_MS": "150"
        }
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/packages/cli/binaries"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/compile.mjs"
      }
    }
  }
}
