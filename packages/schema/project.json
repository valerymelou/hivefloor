{
  "name": "schema",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/schema/src",
  "projectType": "library",
  "tags": ["type:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/schema",
        "main": "packages/schema/src/index.ts",
        "tsConfig": "packages/schema/tsconfig.lib.json",
        "assets": ["packages/schema/*.md"]
      }
    },
    "typecheck": {},
    "json-schema": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run src/json-schema.spec.ts src/config-reference.spec.ts --update --coverage.enabled=false"
      },
      "outputs": [
        "{projectRoot}/office.schema.json",
        "{projectRoot}/machine.schema.json",
        "{workspaceRoot}/docs/configuration-reference.md"
      ]
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/office.config.example.json"]
    }
  }
}
